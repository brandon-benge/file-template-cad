#!/usr/bin/env bash
set -Eeuo pipefail

readonly TRIGGER_FILE="${1:?Usage: $0 <trigger.json>}"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly MODEL_REFERENCE="${AICAD_OPENCODE_MODEL:-}"
readonly AGENT="${OPENCODE_AGENT:?OPENCODE_AGENT is required}"
readonly VALIDATOR="${AICAD_VALIDATION_EXECUTABLE:?AICAD_VALIDATION_EXECUTABLE is required}"
readonly FAILURE_ARTIFACT_ROOT="${AICAD_FAILURE_ARTIFACT_DIR:?AICAD_FAILURE_ARTIFACT_DIR is required}"
readonly MAX_EVENTS_BYTES=8388608
readonly MAX_EVENT_LINE_BYTES=262144
readonly MAX_STDERR_BYTES=1048576
readonly MAX_MODEL_REFERENCE_BYTES=256
readonly MAX_MODEL_CATALOG_BYTES=1048576
readonly DEFAULT_OPENCODE_INACTIVITY_SECONDS=600
readonly PROVIDER_SECRET_ENV_NAMES="OPENCODE_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY GOOGLE_API_KEY OPENROUTER_API_KEY GROQ_API_KEY XAI_API_KEY DEEPINFRA_API_KEY MISTRAL_API_KEY GITHUB_TOKEN"

OPENCODE_INACTIVITY_SECONDS="${AICAD_OPENCODE_INACTIVITY_SECONDS:-$DEFAULT_OPENCODE_INACTIVITY_SECONDS}"
case "$OPENCODE_INACTIVITY_SECONDS" in
  ""|*[!0-9]*) echo "AICAD_OPENCODE_INACTIVITY_SECONDS must be a positive integer" >&2; exit 64 ;;
esac
test "$OPENCODE_INACTIVITY_SECONDS" -gt 0 || {
  echo "AICAD_OPENCODE_INACTIVITY_SECONDS must be a positive integer" >&2
  exit 64
}
readonly OPENCODE_INACTIVITY_SECONDS

# The fixed provider -> credential environment-variable table is shared with
# the AI CAD app and asserted by the workflow-policy and app tests.
readonly OPENCODE_ZEN_ENV=OPENCODE_API_KEY
readonly OPENCODE_GO_ENV=OPENCODE_API_KEY
readonly OPENAI_ENV=OPENAI_API_KEY
readonly ANTHROPIC_ENV=ANTHROPIC_API_KEY
readonly GOOGLE_ENV=GOOGLE_API_KEY
readonly OPENROUTER_ENV=OPENROUTER_API_KEY
readonly GROQ_ENV=GROQ_API_KEY
readonly XAI_ENV=XAI_API_KEY
readonly DEEPINFRA_ENV=DEEPINFRA_API_KEY
readonly MISTRAL_ENV=MISTRAL_API_KEY

export AICAD_SECRET_ENV_NAMES="$PROVIDER_SECRET_ENV_NAMES"
export AICAD_MAX_MODEL_CATALOG_BYTES="$MAX_MODEL_CATALOG_BYTES"

# Validate the repository-scoped provider/model reference before OpenCode runs.
# The reference is required but never falls back to a default model. Sets the
# provider_id/model_id/model_parse_error globals and returns 0 on success.
validate_model_reference() {
  local reference="$1"
  model_parse_error=""
  provider_id=""
  model_id=""
  if test -z "$reference"; then
    model_parse_error="AICAD_OPENCODE_MODEL is not set; configure the repository variable"
    return 1
  fi
  if test "$(printf '%s' "$reference" | wc -c)" -gt "$MAX_MODEL_REFERENCE_BYTES"; then
    model_parse_error="AICAD_OPENCODE_MODEL exceeds $MAX_MODEL_REFERENCE_BYTES bytes"
    return 1
  fi
  if test "$(printf '%s' "$reference" | tr -cd '/')" != "/"; then
    model_parse_error="AICAD_OPENCODE_MODEL must be exactly providerID/modelID with one slash"
    return 1
  fi
  case "$reference" in
    *[[:space:][:cntrl:]]*)
      model_parse_error="AICAD_OPENCODE_MODEL must not contain whitespace or control characters"
      return 1 ;;
  esac
  local provider="${reference%%/*}"
  local model="${reference#*/}"
  if test -z "$provider" || test -z "$model"; then
    model_parse_error="AICAD_OPENCODE_MODEL provider and model ids must both be non-empty"
    return 1
  fi
  local env_name=""
  case "$provider" in
    opencode-zen) env_name="$OPENCODE_ZEN_ENV" ;;
    opencode-go) env_name="$OPENCODE_GO_ENV" ;;
    openai) env_name="$OPENAI_ENV" ;;
    anthropic) env_name="$ANTHROPIC_ENV" ;;
    google) env_name="$GOOGLE_ENV" ;;
    openrouter) env_name="$OPENROUTER_ENV" ;;
    groq) env_name="$GROQ_ENV" ;;
    xai) env_name="$XAI_ENV" ;;
    deepinfra) env_name="$DEEPINFRA_ENV" ;;
    mistral) env_name="$MISTRAL_ENV" ;;
    *) model_parse_error="Unknown provider id: $provider"; return 1 ;;
  esac
  if test -z "${!env_name:-}"; then
    model_parse_error="$env_name is not set for provider $provider; add the provider API key repository secret"
    return 1
  fi
  provider_id="$provider"
  model_id="$model"
  return 0
}

# Copies the bounded run evidence into the validated failure artifact directory.
write_failure_artifact() {
  mkdir "$FAILURE_RUN_DIR"
  cp "$TEMP_RUN/run.json" "$TEMP_RUN/events.jsonl" "$FAILURE_RUN_DIR/"
  cp "$TEMP_ROOT/stderr.log" "$FAILURE_RUN_DIR/stderr.log"
  jq -n \
    --arg run_id "$RUN_ID" \
    --slurpfile events "$TEMP_ROOT/events-stats.json" \
    --slurpfile stderr "$TEMP_ROOT/stderr-stats.json" \
    '{artifact_schema_version: 1, run_id: $run_id, events: $events[0], stderr: $stderr[0]}' \
    > "$FAILURE_RUN_DIR/artifact.json"
}

# Defensive, bounded, redacted diagnostic dump for failed runs. The catalog is
# captured only here so successful runs never pay for it. All three provider
# credentials plus GITHUB_TOKEN are redacted before persistence.
write_diagnostic_dump() {
  local version=""
  version="$(opencode --version 2>/dev/null || printf 'unavailable')"
  test -n "$version" || version="unavailable"
  : > "$TEMP_ROOT/model-catalog.raw"
  if command -v opencode >/dev/null 2>&1; then
    (opencode models 2>/dev/null || printf 'opencode models failed\n') > "$TEMP_ROOT/model-catalog.raw" || true
  else
    printf 'opencode not found\n' > "$TEMP_ROOT/model-catalog.raw"
  fi
  python3 - "$TEMP_ROOT/model-catalog.raw" "$TEMP_ROOT/model-catalog.txt" "$TEMP_ROOT/model-catalog-stats.json" <<'PY'
import hashlib, json, os, sys
source, destination, stats_path = sys.argv[1:]
secret_env_names = os.environ.get("AICAD_SECRET_ENV_NAMES", "").split()
secrets = [value for name in secret_env_names for value in [os.environ.get(name, "")] if value]
raw = open(source, "rb").read()
text = raw.decode("utf-8", "replace")
for secret in secrets:
    text = text.replace(secret, "[authentication protected]")
encoded = text.encode("utf-8")
limit = int(os.environ.get("AICAD_MAX_MODEL_CATALOG_BYTES", "1048576"))
truncated = len(encoded) > limit
retained = encoded[:limit] if truncated else encoded
open(destination, "wb").write(retained)
json.dump({
    "original_bytes": len(encoded),
    "retained_bytes": len(retained),
    "truncated": truncated,
    "sha256": hashlib.sha256(retained).hexdigest(),
}, open(stats_path, "w"))
PY
  jq -n \
    --arg version "$version" \
    --slurpfile catalog "$TEMP_ROOT/model-catalog-stats.json" \
    --rawfile catalog_text "$TEMP_ROOT/model-catalog.txt" \
    --arg reference "$MODEL_REFERENCE" \
    --arg provider_id "${provider_id:-}" \
    --arg model_id "${model_id:-}" \
    --arg parse_error "${model_parse_error:-}" \
    --argjson presence "$presence_json" \
    '{
      artifact_schema_version: 1,
      opencode_version: $version,
      model_catalog: ($catalog[0] + {text: $catalog_text}),
      attempted_reference: $reference,
      parse: {provider_id: $provider_id, model_id: $model_id, error: (if $parse_error == "" then null else $parse_error end)},
      credential_presence: $presence
    }' > "$FAILURE_RUN_DIR/provider-model-diagnostic.json"
}

# Fail-fast path for an invalid or unset provider/model selection. Writes the
# standard failure artifact plus the diagnostic dump and exits 67 before
# OpenCode runs. No fallback model is ever substituted.
fail_model_selection() {
  status="failed"
  failure_stage="model_selection"
  opencode_exit=0
  filter_exit=0
  validation_exit=0
  completed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  : > "$TEMP_RUN/events.jsonl"
  : > "$TEMP_ROOT/stderr.log"
  printf '%s\n' '{"original_bytes":0,"retained_bytes":0,"truncated":false}' > "$TEMP_ROOT/events-stats.json"
  printf '%s\n' '{"original_bytes":0,"retained_bytes":0,"truncated":false}' > "$TEMP_ROOT/stderr-stats.json"
  local events_sha="$(shasum -a 256 "$TEMP_RUN/events.jsonl" | awk '{print $1}')"
  local opencode_version="$(opencode --version 2>/dev/null || printf 'unavailable')"
  jq -n \
    --slurpfile trigger "$TEMP_ROOT/safe-trigger.json" \
    --slurpfile stats "$TEMP_ROOT/events-stats.json" \
    --arg run_id "$RUN_ID" \
    --arg model "$MODEL_REFERENCE" \
    --arg agent "$AGENT" \
    --arg opencode_version "$opencode_version" \
    --arg provider_id "${provider_id:-}" \
    --arg model_id "${model_id:-}" \
    --argjson presence "$presence_json" \
    --arg started_at "$started_at" \
    --arg completed_at "$completed_at" \
    --arg start_sha "$START_SHA" \
    --arg events_sha "$events_sha" \
    '{
      schema_version: 1,
      run_id: $run_id,
      source: "github-actions",
      github: $trigger[0],
      opencode: {version: $opencode_version, model: $model, agent: $agent, exit_code: 0, provider_id: $provider_id, model_id: $model_id, credential_presence: $presence},
      started_at: $started_at,
      completed_at: $completed_at,
      status: "failed",
      failure_stage: "model_selection",
      starting_revision: $start_sha,
      candidate_changed_paths: [],
      validation: [{command: "python-cad validate --project-root .", exit_code: 0}],
      events: ($stats[0] + {sha256: $events_sha})
    }' > "$TEMP_RUN/run.json"
  write_failure_artifact
  write_diagnostic_dump
  echo "OpenCode model selection failed: $model_parse_error" >&2
  echo "OpenCode transaction failed at model_selection; repository history was not changed" >&2
  exit 67
}

ROOT="$(git rev-parse --show-toplevel)"
test "$ROOT" = "$(pwd -P)" || { echo "Run from the repository root" >&2; exit 64; }
ARTIFACT_ROOT="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$FAILURE_ARTIFACT_ROOT")"
case "$ARTIFACT_ROOT/" in
  "$ROOT"/|"$ROOT"/*) echo "Failure artifact directory must be outside the repository" >&2; exit 64 ;;
esac
readonly ARTIFACT_ROOT
mkdir -p "$ARTIFACT_ROOT"
test -f "$TRIGGER_FILE" || { echo "Trigger file not found" >&2; exit 64; }
jq -e '.run_id and .run_attempt and .repository_id and .issue.number' "$TRIGGER_FILE" >/dev/null

GITHUB_RUN="$(jq -r '.run_id' "$TRIGGER_FILE")"
GITHUB_ATTEMPT="$(jq -r '.run_attempt' "$TRIGGER_FILE")"
case "$GITHUB_RUN:$GITHUB_ATTEMPT" in
  *[!0-9:]*|:*|*:) echo "Invalid GitHub run identity" >&2; exit 64 ;;
esac
readonly RUN_ID="${GITHUB_RUN}-${GITHUB_ATTEMPT}"
readonly RUN_DIR=".aicad/audit/v1/${RUN_ID}"
readonly FAILURE_RUN_DIR="$ARTIFACT_ROOT/$RUN_ID"
test ! -e "$RUN_DIR" || { echo "Audit run already exists: $RUN_ID" >&2; exit 65; }
test ! -e "$FAILURE_RUN_DIR" || { echo "Failure artifact already exists: $RUN_ID" >&2; exit 65; }

readonly START_SHA="$(git rev-parse HEAD)"
readonly TEMP_ROOT="$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/aicad-audit.XXXXXX")"
readonly TEMP_RUN="$TEMP_ROOT/$RUN_ID"
mkdir -p "$TEMP_RUN"
cp "$TRIGGER_FILE" "$TEMP_ROOT/trigger.json"

python3 - "$TRIGGER_FILE" "$TEMP_ROOT/safe-trigger.json" <<'PY'
import json, os, sys
source, destination = sys.argv[1:]
secret_env_names = os.environ.get("AICAD_SECRET_ENV_NAMES", "").split()
secrets = [value for name in secret_env_names for value in [os.environ.get(name, "")] if value]
value = json.load(open(source))
def protect(item):
    if isinstance(item, dict): return {key: protect(child) for key, child in item.items()}
    if isinstance(item, list): return [protect(child) for child in item]
    if isinstance(item, str):
        for secret in secrets: item = item.replace(secret, "[authentication protected]")
    return item
value = protect(value)
value["issue"]["title"] = value["issue"].get("title", "")[:1024]
value["issue"]["body"] = value["issue"].get("body", "")[:65536]
if value.get("comment"):
    value["comment"]["body"] = value["comment"].get("body", "")[:65536]
json.dump(value, open(destination, "w"), separators=(",", ":"))
PY

cleanup() { rm -rf "$TEMP_ROOT"; }
trap cleanup EXIT

started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

presence_json="$(jq -n \
  --argjson opencode "$(if test -n "${OPENCODE_API_KEY:-}"; then printf true; else printf false; fi)" \
  --argjson openai "$(if test -n "${OPENAI_API_KEY:-}"; then printf true; else printf false; fi)" \
  --argjson anthropic "$(if test -n "${ANTHROPIC_API_KEY:-}"; then printf true; else printf false; fi)" \
  --argjson google "$(if test -n "${GOOGLE_API_KEY:-}"; then printf true; else printf false; fi)" \
  --argjson openrouter "$(if test -n "${OPENROUTER_API_KEY:-}"; then printf true; else printf false; fi)" \
  --argjson groq "$(if test -n "${GROQ_API_KEY:-}"; then printf true; else printf false; fi)" \
  --argjson xai "$(if test -n "${XAI_API_KEY:-}"; then printf true; else printf false; fi)" \
  --argjson deepinfra "$(if test -n "${DEEPINFRA_API_KEY:-}"; then printf true; else printf false; fi)" \
  --argjson mistral "$(if test -n "${MISTRAL_API_KEY:-}"; then printf true; else printf false; fi)" \
  '{OPENCODE_API_KEY_PRESENT: $opencode, OPENAI_API_KEY_PRESENT: $openai, ANTHROPIC_API_KEY_PRESENT: $anthropic, GOOGLE_API_KEY_PRESENT: $google, OPENROUTER_API_KEY_PRESENT: $openrouter, GROQ_API_KEY_PRESENT: $groq, XAI_API_KEY_PRESENT: $xai, DEEPINFRA_API_KEY_PRESENT: $deepinfra, MISTRAL_API_KEY_PRESENT: $mistral}')"
validate_model_reference "$MODEL_REFERENCE" || fail_model_selection

event_name="$(jq -r '.event_name' "$TRIGGER_FILE")"
issue_number="$(jq -r '.issue.number' "$TRIGGER_FILE")"
issue_title="$(jq -r '.issue.title // ""' "$TRIGGER_FILE")"
issue_body="$(jq -r '.issue.body // ""' "$TRIGGER_FILE")"
comment_body="$(jq -r '.comment.body // ""' "$TRIGGER_FILE")"
if test "$event_name" = "issue_comment"; then
  request_text="$(printf '%s' "$comment_body" | sed -E '1s#^/(oc|opencode)([[:space:]]+)?##')"
else
  request_text="$issue_body"
fi

prompt="$(printf '%s\n\n%s\n\n%s' \
  "Work on GitHub issue #$issue_number: $issue_title" \
  "$request_text" \
  'Follow repository governance. Make only requested source changes and run relevant checks. Finish all requested geometry, metadata, material, and user-facing-name edits before starting final verification. After final verification succeeds, do not make another source edit unless a concrete check or requested acceptance criterion failed. Run every long-running test, validation, build, and verification command as a separate tool call. Do not chain commands with &&, ;, or pipes, and do not start these commands in parallel or in the background. Wait for each command to finish before starting the next so progress and failures remain observable. Do not run git, commit, push, or edit .aicad/audit; the workflow owns validation and Git persistence.')"

# Filter stdout before both display and persistence. Exact known credentials
# are replaced, oversized lines are represented by a valid JSON marker, and
# the retained file stops at the V1 budget while stdout keeps draining.
cat > "$TEMP_ROOT/filter.py" <<'PY'
import json, os, sys

limit = int(os.environ["AICAD_EVENTS_LIMIT"])
line_limit = int(os.environ["AICAD_EVENT_LINE_LIMIT"])
secret_env_names = os.environ.get("AICAD_SECRET_ENV_NAMES", "").split()
secrets = [value for name in secret_env_names for value in [os.environ.get(name, "")] if value]
retained = 0
total = 0
truncated = False
output = open(os.environ["AICAD_EVENTS_FILE"], "wb")
for raw in sys.stdin.buffer:
    total += len(raw)
    text = raw.decode("utf-8", "replace")
    for secret in secrets:
        text = text.replace(secret, "[authentication protected]")
    try:
        json.loads(text)
    except json.JSONDecodeError:
        text = json.dumps({"type": "unparsed_output", "text": text.rstrip("\r\n")}) + "\n"
    encoded = text.encode("utf-8")
    if len(encoded) > line_limit:
        encoded = (json.dumps({"type": "truncated_event", "original_bytes": len(encoded)}) + "\n").encode()
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.flush()
    if retained + len(encoded) <= limit:
        output.write(encoded)
        retained += len(encoded)
    elif not truncated:
        marker = (json.dumps({"type": "audit_truncated", "retained_bytes": retained}) + "\n").encode()
        if retained + len(marker) <= limit:
            output.write(marker)
            retained += len(marker)
        truncated = True
output.close()
json.dump({"original_bytes": total, "retained_bytes": retained, "truncated": truncated}, open(os.environ["AICAD_EVENTS_STATS"], "w"))
PY

cat > "$TEMP_ROOT/stderr-filter.py" <<'PY'
import json, os, sys
limit = int(os.environ["AICAD_STDERR_LIMIT"])
secret_env_names = os.environ.get("AICAD_SECRET_ENV_NAMES", "").split()
secrets = [value for name in secret_env_names for value in [os.environ.get(name, "")] if value]
retained = 0
total = 0
truncated = False
output = open(os.environ["AICAD_STDERR_FILE"], "wb")
for text in sys.stdin:
    total += len(text.encode("utf-8"))
    for secret in secrets:
        text = text.replace(secret, "[authentication protected]")
    sys.stderr.write(text)
    sys.stderr.flush()
    encoded = text.encode("utf-8")
    remaining = limit - retained
    if remaining > 0:
        chunk = encoded[:remaining]
        output.write(chunk)
        retained += len(chunk)
    if len(encoded) > remaining:
        truncated = True
output.close()
json.dump({"original_bytes": total, "retained_bytes": retained, "truncated": truncated}, open(os.environ["AICAD_STDERR_STATS"], "w"))
PY

set +e
export AICAD_EVENTS_LIMIT="$MAX_EVENTS_BYTES"
export AICAD_EVENT_LINE_LIMIT="$MAX_EVENT_LINE_BYTES"
export AICAD_EVENTS_FILE="$TEMP_RUN/events.jsonl"
export AICAD_EVENTS_STATS="$TEMP_ROOT/events-stats.json"
export AICAD_STDERR_LIMIT="$MAX_STDERR_BYTES"
export AICAD_STDERR_FILE="$TEMP_ROOT/stderr.log"
export AICAD_STDERR_STATS="$TEMP_ROOT/stderr-stats.json"
python3 "$SCRIPT_DIR/run-with-inactivity-watchdog" "$OPENCODE_INACTIVITY_SECONDS" \
  opencode run --format json --model "$MODEL_REFERENCE" --agent "$AGENT" -- "$prompt"
opencode_exit=$?
filter_exit=0
set -e
test -f "$TEMP_RUN/events.jsonl" || : > "$TEMP_RUN/events.jsonl"
test -f "$TEMP_ROOT/events-stats.json" || printf '%s\n' \
  '{"original_bytes":0,"retained_bytes":0,"truncated":false}' > "$TEMP_ROOT/events-stats.json"
test -f "$TEMP_ROOT/stderr.log" || : > "$TEMP_ROOT/stderr.log"
test -f "$TEMP_ROOT/stderr-stats.json" || printf '%s\n' \
  '{"original_bytes":0,"retained_bytes":0,"truncated":false}' > "$TEMP_ROOT/stderr-stats.json"

status="completed"
failure_stage=""
validation_exit=0
if test "$filter_exit" -ne 0; then
  status="failed"
  failure_stage="event_capture"
elif test "$opencode_exit" -ne 0; then
  status="failed"
  failure_stage="opencode"
elif test "$(git rev-parse HEAD)" != "$START_SHA"; then
  status="failed"
  failure_stage="unexpected_commit"
else
  set +e
  "$VALIDATOR" validate --project-root .
  validation_exit=$?
  set -e
  if test "$validation_exit" -ne 0; then
    status="failed"
    failure_stage="validation"
  fi
fi

git status --porcelain=v1 -z | python3 -c '
import json, sys
raw = sys.stdin.buffer.read().split(b"\0")
paths = []
for item in raw:
    if not item: continue
    text = item.decode("utf-8", "replace")
    path = text[3:] if len(text) > 3 else text
    if path and not path.startswith((".audit-venv/", ".aicad/audit/")):
        paths.append(path)
json.dump(sorted(set(paths))[:2000], sys.stdout)
' > "$TEMP_ROOT/changed-paths.json"

if test "$status" = "completed" && ! jq -e \
  'all(. == "config.py" or . == "model.py" or . == "drawing_annotations.py")' \
  "$TEMP_ROOT/changed-paths.json" >/dev/null; then
  status="failed"
  failure_stage="policy"
fi

if test "$status" = "completed" && test "$(jq length "$TEMP_ROOT/changed-paths.json")" -eq 0; then
  status="no_changes"
fi

completed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
events_sha="$(shasum -a 256 "$TEMP_RUN/events.jsonl" | awk '{print $1}')"
opencode_version="$(opencode --version 2>/dev/null || printf 'unavailable')"
jq -n \
  --slurpfile trigger "$TEMP_ROOT/safe-trigger.json" \
  --slurpfile paths "$TEMP_ROOT/changed-paths.json" \
  --slurpfile stats "$TEMP_ROOT/events-stats.json" \
  --arg run_id "$RUN_ID" \
  --arg model "$MODEL_REFERENCE" \
  --arg agent "$AGENT" \
  --arg opencode_version "$opencode_version" \
  --arg provider_id "${provider_id:-}" \
  --arg model_id "${model_id:-}" \
  --argjson presence "$presence_json" \
  --arg started_at "$started_at" \
  --arg completed_at "$completed_at" \
  --arg status "$status" \
  --arg failure_stage "$failure_stage" \
  --arg start_sha "$START_SHA" \
  --arg events_sha "$events_sha" \
  --argjson opencode_exit "$opencode_exit" \
  --argjson validation_exit "$validation_exit" \
  '{
    schema_version: 1,
    run_id: $run_id,
    source: "github-actions",
    github: $trigger[0],
    opencode: {version: $opencode_version, model: $model, agent: $agent, exit_code: $opencode_exit, provider_id: $provider_id, model_id: $model_id, credential_presence: $presence},
    started_at: $started_at,
    completed_at: $completed_at,
    status: $status,
    failure_stage: (if $failure_stage == "" then null else $failure_stage end),
    starting_revision: $start_sha,
    candidate_changed_paths: $paths[0],
    validation: [{command: "python-cad validate --project-root .", exit_code: $validation_exit}],
    events: ($stats[0] + {sha256: $events_sha})
  }' > "$TEMP_RUN/run.json"

test "$(wc -c < "$TEMP_RUN/run.json")" -le 262144 || { echo "Audit manifest exceeds V1 limit" >&2; exit 66; }

if test "$status" = "failed"; then
  write_failure_artifact
  write_diagnostic_dump
  echo "OpenCode transaction failed at $failure_stage; repository history was not changed" >&2
  if test "$failure_stage" = "unexpected_commit"; then
    git reset --hard "$START_SHA"
  fi
  if test "$filter_exit" -ne 0; then
    exit "$filter_exit"
  elif test "$opencode_exit" -ne 0; then
    exit "$opencode_exit"
  elif test "$validation_exit" -ne 0; then
    exit "$validation_exit"
  fi
  exit 1
fi

# Keep an external safety copy until push succeeds so commit/push failures can
# still be diagnosed without placing failure evidence in repository history.
write_failure_artifact

mkdir -p "$(dirname "$RUN_DIR")"
mv "$TEMP_RUN" "$RUN_DIR"
git add -A -- . ":(exclude).audit-venv"

if test "$status" = "no_changes"; then
  commit_message="chore(opencode): record no-change AI execution $RUN_ID"
else
  commit_message="chore(opencode): record AI execution $RUN_ID"
fi
git commit -m "$commit_message"
git push origin HEAD
rm -rf "$FAILURE_RUN_DIR"
