#!/usr/bin/env python3
"""Reconcile this repository's infrastructure files against a file-template-cad checkout.

"Infrastructure" is every tracked file EXCEPT the four customer-owned CAD authoring
paths (config.py, model.py, drawing_annotations.py, any models/**/*.py) and disposable
build output (generated/). That boundary is the one defined by
MakeItOursDomain.CADAuthoringSurface in the makeitours-app repo, mirrored here.

Every infrastructure file that is missing or differs from the template's version is
overwritten with it; every tracked infrastructure file the template does not have is
removed. Regular files and symlinks are both handled; the four customer-owned paths and
generated/ are never touched.

One exception keeps a project working: pyproject.toml's [tool.python-cad] source-inputs names
the project's own design files, so it is rebuilt rather than copied (2026-10-08 approval,
Amendment 2). Existing design entries stay in the project's order while the file exists,
design files present but not listed are appended (sorted), and other entries follow the
template. A project whose list already matches its files keeps it byte-for-byte. The app's
InfrastructureReconciler applies the same rule.

Usage: reconcile-infrastructure [--plan] [--source] <path-to-file-template-cad>

  --plan    print the changes as JSON ({"schema_version": 1, "changes": [{"path", "action"}]},
            action add | update | remove) and write nothing.
  --source  the template is a plain directory (an extracted release archive), not a git
            checkout: every file under it except generated/ and .makeitours/audit/ counts.

Upgrades only (2026-10-09 approval, project-upgrade-button): MakeItOurs no longer runs this
automatically; Upgrade Project runs it against a verified file-template-cad release.

Run from the repository root. Invoked by makeitours-agentic-git-run (the makeitours.yml ticket
runner) before the agent runs, so the AI works against an up-to-date template. Unlike the makeitours-app Mac
client (which vendors a snapshot to avoid a Guideline 2.5.2 risk in a sandboxed,
App-Store-distributed binary), this is developer-controlled CI and reconciles against the
template's live committed content -- see
specrepo/requests/2026-09-01-cad-infrastructure-abstraction.md.
"""

from __future__ import annotations

import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tomllib

_CUSTOMER_TOP_LEVEL = {"config.py", "model.py", "drawing_annotations.py"}
#: Written into each release archive by release-template.yml: which release a project's
#: infrastructure came from (2026-10-09 approval, project-upgrade-button).
RELEASE_IDENTITY = ".makeitours/template-release.json"


def _is_customer_owned(relative_path: str) -> bool:
    if relative_path in _CUSTOMER_TOP_LEVEL:
        return True
    return relative_path.startswith("models/") and relative_path.endswith(".py")


def _is_infrastructure(relative_path: str) -> bool:
    if _is_customer_owned(relative_path):
        return False
    # Disposable build output, and the per-project Git-triggered audit trail (runtime
    # history, not template content -- .makeitours/schema/ IS template infrastructure and
    # stays).
    for prefix in ("generated", ".makeitours/audit"):
        if relative_path == prefix or relative_path.startswith(prefix + "/"):
            return False
    return True


def _tracked_infrastructure(root: pathlib.Path) -> list[str]:
    result = subprocess.run(
        ["git", "-C", str(root), "ls-files", "-z"],
        capture_output=True,
        check=True,
    )
    return [
        part.decode("utf-8")
        for part in result.stdout.split(b"\x00")
        if part and _is_infrastructure(part.decode("utf-8"))
    ]


def _walked_infrastructure(root: pathlib.Path) -> list[str]:
    """Every regular file or symlink under a plain template directory (no git metadata)."""
    found: list[str] = []
    for path in sorted(root.rglob("*")):
        if path.is_dir() and not path.is_symlink():
            continue
        relative = path.relative_to(root).as_posix()
        if relative.startswith(".git/") or relative == ".git":
            continue
        if _is_infrastructure(relative):
            found.append(relative)
    return found


def _remove(path: pathlib.Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


_SOURCE_INPUTS = re.compile(r"^source-inputs = \[\n(?:.*\n)*?\]", re.MULTILINE)


def _source_inputs(text: str) -> list[str] | None:
    try:
        value = tomllib.loads(text).get("tool", {}).get("python-cad", {}).get("source-inputs")
    except tomllib.TOMLDecodeError:
        return None
    return [entry for entry in value if isinstance(entry, str)] if isinstance(value, list) else None


def _design_files(repo: pathlib.Path) -> list[str]:
    found = [name for name in sorted(_CUSTOMER_TOP_LEVEL) if (repo / name).is_file()]
    models = repo / "models"
    if models.is_dir():
        found += sorted(
            path.relative_to(repo).as_posix() for path in models.rglob("*.py") if path.is_file() and not path.is_symlink()
        )
    return found


def merged_source_inputs(project: list[str] | None, template: list[str], design_on_disk: list[str]) -> list[str]:
    """The project's design-file list kept, the template's other entries applied."""
    present = set(design_on_disk)
    template_other = [entry for entry in template if not _is_customer_owned(entry)]
    result: list[str] = []
    for entry in project if project is not None else template:
        if entry in result:
            continue
        if (entry in present) if _is_customer_owned(entry) else (entry in template_other):
            result.append(entry)
    result += [entry for entry in template_other if entry not in result]
    result += [entry for entry in design_on_disk if entry not in result]
    return result


def _reconciled_pyproject(template_text: str, project_text: str | None, repo: pathlib.Path) -> str:
    """The template's pyproject.toml with source-inputs rebuilt for this project."""
    template_list = _source_inputs(template_text)
    match = _SOURCE_INPUTS.search(template_text)
    if template_list is None or match is None:
        return template_text
    project_list = _source_inputs(project_text) if project_text is not None else None
    entries = merged_source_inputs(project_list, template_list, _design_files(repo))
    block = "source-inputs = [\n" + "".join(f'  "{entry}",\n' for entry in entries) + "]"
    return template_text[: match.start()] + block + template_text[match.end() :]


def _desired_pyproject(source: pathlib.Path, destination: pathlib.Path, repo: pathlib.Path) -> str:
    project_text = destination.read_text() if destination.is_file() and not destination.is_symlink() else None
    return _reconciled_pyproject(source.read_text(), project_text, repo)


def _action(source: pathlib.Path, destination: pathlib.Path, relative_path: str, repo: pathlib.Path) -> str | None:
    """`add`, `update` or None (already equal) for one template entry."""
    exists = os.path.lexists(destination)
    if source.is_symlink():
        if destination.is_symlink() and os.readlink(destination) == os.readlink(source):
            return None
        return "update" if exists else "add"
    if not source.is_file():
        # A gitlink/submodule or something else this reconciler has no opinion about.
        return None
    if relative_path == "pyproject.toml":
        desired = _desired_pyproject(source, destination, repo).encode()
    else:
        desired = source.read_bytes()
    if destination.is_file() and not destination.is_symlink() and destination.read_bytes() == desired:
        return None
    return "update" if exists else "add"


def plan(template: pathlib.Path, repo: pathlib.Path, *, source_tree: bool = False) -> list[dict[str, str]]:
    """The changes that bring `repo`'s infrastructure to `template`, without writing anything."""
    template_infra = _walked_infrastructure(template) if source_tree else _tracked_infrastructure(template)
    template_set = set(template_infra)
    changes: list[dict[str, str]] = []
    for relative_path in template_infra:
        action = _action(template / relative_path, repo / relative_path, relative_path, repo)
        if action:
            changes.append({"path": relative_path, "action": action})
    for relative_path in _tracked_infrastructure(repo):
        # The release identity exists only in release archives, never in a template checkout,
        # so planning against a checkout must not delete it.
        if relative_path == RELEASE_IDENTITY:
            continue
        if relative_path not in template_set and os.path.lexists(repo / relative_path):
            changes.append({"path": relative_path, "action": "remove"})
    return sorted(changes, key=lambda change: change["path"])


def apply(template: pathlib.Path, repo: pathlib.Path, changes: list[dict[str, str]]) -> None:
    for change in changes:
        relative_path, target = change["path"], repo / change["path"]
        if _is_customer_owned(relative_path):
            raise RuntimeError(f"refusing to change a design file: {relative_path}")
        if change["action"] == "remove":
            _remove(target)
            continue
        source = template / relative_path
        desired_pyproject = _desired_pyproject(source, target, repo) if relative_path == "pyproject.toml" else None
        if os.path.lexists(target):
            _remove(target)
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            os.symlink(os.readlink(source), target)
        elif desired_pyproject is not None:
            target.write_text(desired_pyproject)
            shutil.copymode(source, target)
        else:
            shutil.copyfile(source, target)
            shutil.copymode(source, target)


def main(argv: list[str]) -> int:
    args = argv[1:]
    dry_run = "--plan" in args
    source_tree = "--source" in args
    positional = [arg for arg in args if arg not in ("--plan", "--source")]
    if len(positional) != 1 or any(arg.startswith("--") for arg in positional):
        print(__doc__, file=sys.stderr)
        return 64
    template = pathlib.Path(positional[0]).resolve()
    if not (template / "pyproject.toml").is_file():
        print(f"Not a file-template-cad checkout or release: {template}", file=sys.stderr)
        return 64
    repo = pathlib.Path.cwd()

    changes = plan(template, repo, source_tree=source_tree)
    if dry_run:
        print(json.dumps({"schema_version": 1, "changes": changes}, sort_keys=True))
        return 0
    apply(template, repo, changes)
    for change in changes:
        print(f"reconciled {change['path']}")
    print(f"{len(changes)} infrastructure file(s) reconciled")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
