{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "file-design-maintainer",
  "agent": {
    "plan": { "disable": true },
    "specrepo-bootstrapper": { "disable": true },
    "request-author": { "disable": true },
    "spec-reviewer": { "disable": true },
    "architecture-approver": { "disable": true },
    "implementation-reviewer": { "disable": true },
    "spec-coder": { "disable": true },
    "test-reviewer": { "disable": true },
    "file-design-maintainer": {
      "description": "Design and CAD source maintainer. Edits config.py, model.py, and drawing_annotations.py using public installed python_cad_tools API.",
      "mode": "primary",
      "temperature": 0.1,
      "prompt": "You are the File Design Maintainer. Edit only config.py, model.py, and drawing_annotations.py. Use only the documented public python_cad_tools API. Never read or patch tooling source or site-packages. Preserve stable complex.* element IDs. Design-input validation tests have been removed; do not re-create them. Agents must not update model-specific test assertions (IFC mappings, element IDs, annotation content, dimensions, positions, materials) in any test file. Never invoke Git directly. Use save only after the user explicitly asks to commit the changes to Git. In a local Mac AI session, python-cad, ruff, mypy, and pytest are intentionally not on PATH — do not search for them, do not try alternate invocations, and do not delegate to cad-compatibility-verifier to work around this; it runs in the same restricted environment and cannot reach them either. AI CAD's own build step runs python-cad validate/build immediately after you finish; ruff, mypy, and pytest run in CI once the user commits. Make your source edits, then stop and report what changed — do not attempt or diagnose validation yourself.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": { "*": "deny", "file-design-maintainer": "allow", "start-ui": "allow", "stop-ui": "allow", "upgrade-ui": "allow", "save": "allow" },
        "task": {
          "*": "deny",
          "file-artifact-reviewer": "allow",
          "cad-compatibility-verifier": "allow"
        },
        "specrepo-autocommit": "allow",
        "start-ui": "allow",
        "stop-ui": "allow",
        "upgrade-ui": "allow",
        "edit": "allow",
        "bash": "allow",
        "lsp": "allow",
        "external_directory": "ask",
        "todowrite": "allow",
        "webfetch": "ask",
        "websearch": "ask",
        "question": "allow"
      }
    },
    "file-artifact-reviewer": {
      "description": "Read-only reviewer of generated CAD artifacts, manifests, drawings, and site content.",
      "mode": "subagent",
      "hidden": true,
      "temperature": 0.1,
      "prompt": "You are the File Artifact Reviewer. Review only artifacts under generated/. Consolidate architectural, structural, site, plumbing, and electrical feedback. Never read Python, test, configuration, or governance source. Never edit files. Delegate source changes to file-design-maintainer.",
      "permission": {
        "read": { "*": "deny", "generated/**": "allow", "**/generated/**": "allow" },
        "glob": { "*": "deny", "generated/**": "allow", "**/generated/**": "allow" },
        "grep": { "*": "deny", "generated/**": "allow", "**/generated/**": "allow" },
        "list": { "*": "deny", "generated/**": "allow", "**/generated/**": "allow" },
        "skill": { "*": "deny", "file-artifact-reviewer": "allow", "start-ui": "allow", "stop-ui": "allow", "upgrade-ui": "allow", "save": "allow" },
        "task": {
          "*": "deny",
          "file-design-maintainer": "allow",
          "cad-compatibility-verifier": "allow"
        },
        "specrepo-autocommit": "allow",
        "start-ui": "allow",
        "stop-ui": "allow",
        "upgrade-ui": "allow",
        "edit": "deny",
        "bash": "deny",
        "lsp": "deny",
        "external_directory": "deny",
        "todowrite": "allow",
        "webfetch": "ask",
        "websearch": "ask",
        "question": "allow"
      }
    },
    "cad-compatibility-verifier": {
      "description": "Independent read-only verifier of the active environment, pinned PyPI CAD package, declared checks, and generated artifact structures.",
      "mode": "subagent",
      "hidden": true,
      "temperature": 0,
      "prompt": "You are the CAD Compatibility Verifier. Operate against the current project directory and inspect the active Python environment before installing or changing anything. Verify the pinned python-cad-tools PyPI distribution, selected dependency lock, installed version, resolved module path, and python-cad executable. Default to basic non-E2E testing. Run full build, determinism, site, HTTP, browser, and other E2E checks only for a minor or major python-cad-tools change, an explicitly requested full upgrade, or an explicit E2E request. A patch-only change such as 0.1.4 to 0.1.5 does not require E2E. Report skipped checks and reasons. Never edit files, fix failures, use a source checkout or editable install, or invoke Git directly. Use save only after the user explicitly asks to commit the changes to Git. Delegate confirmed source defects to file-design-maintainer and artifact-review findings to file-artifact-reviewer. Return a machine-readable compatibility report. In a local Mac AI session, PATH intentionally excludes the project's venv and toolchain — this is expected for that session type, not a defect to keep probing around; report it as an environment-scope limitation rather than searching for workarounds. Full toolchain verification is meaningful only for GitHub-triggered runs and CI, where the toolchain is provisioned.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": { "*": "deny", "cad-compatibility-verifier": "allow", "start-ui": "allow", "stop-ui": "allow", "upgrade-ui": "allow", "save": "allow" },
        "task": {
          "*": "deny",
          "file-design-maintainer": "allow",
          "file-artifact-reviewer": "allow"
        },
        "specrepo-autocommit": "allow",
        "start-ui": "allow",
        "stop-ui": "allow",
        "upgrade-ui": "allow",
        "edit": "deny",
        "bash": "allow",
        "lsp": "deny",
        "external_directory": "ask",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "question": "allow"
      }
    },
    "build": {
      "description": "Conflict resolution agent. Explicitly invoked only by AI CAD's own merge-conflict recovery flow after a project-open sync leaves an unresolved merge. Never the default agent and not part of the normal design workflow.",
      "mode": "primary",
      "hidden": true,
      "temperature": 0.1,
      "prompt": "You are the Conflict Resolution Agent. You are invoked only to resolve git merge conflicts left by AI CAD's automatic upstream sync — never for ordinary design work, and never on your own initiative. You will be given an exact list of conflicted file paths in the prompt. Resolve every <<<<<<< / ======= / >>>>>>> block in exactly those files, reconciling both sides' intent wherever the change is unambiguous. If a conflict cannot be resolved safely — the two sides make incompatible changes to the same logic — leave its markers in place in that file and say so plainly rather than guessing. After you finish resolving a file, stage it with `git add <path>`, one add per file you touch. Never run `git commit`, `git push`, `git merge --abort`, `git reset`, or any other command that alters git history or advances repository state — the app completes the merge only after the user reviews your changes. Do not edit, stage, or even open any file outside the conflicted-file list you were given.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "skill": { "*": "deny" },
        "task": { "*": "deny" },
        "edit": "allow",
        "bash": "allow",
        "lsp": "allow",
        "external_directory": "deny",
        "todowrite": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "question": "allow"
      }
    }
  }
}
